{
  "rules": {
    ".read": false,
    ".write": false,

    "players":            { ".read": true, "$pcid": { ".read": true, ".write": true } },
    "hp_players":         { ".read": true, "$pcid": { ".read": true, ".write": true } },
    "hp_names":           { ".read": true, "$name": { ".read": true, ".write": true } },
    "hp_migrations":      { ".read": true, "$pcid": { ".read": true, ".write": true } },
    "apples_players":     { ".read": true, "$pcid": { ".read": true, ".write": true } },
    "dodgeball_players":  { ".read": true, "$pcid": { ".read": true, ".write": true } },

    "hp_rooms":     { ".read": true, "$code": { ".read": true, ".write": true } },
    "dodgeball":    { ".read": true, "$code": { ".read": true, ".write": true } },
    "rooms":        { ".read": true, "$code": { ".read": true, ".write": true } },
    "pacific":      { ".read": true, "$code": { ".read": true, ".write": true } },
    "treasureHunt": { ".read": true, "$code": { ".read": true, ".write": true } },
    "apples_rooms": { ".read": true, "$id":   { ".read": true, ".write": true } },

    "tetris":        { ".read": true, "$section": { ".read": true, "$id": { ".read": true, ".write": true } } },
    "stellar":       { ".read": true, "$section": { ".read": true, "$id": { ".read": true, ".write": true } } },
    "showdown":      { ".read": true, "$section": { ".read": true, "$id": { ".read": true, ".write": true } } },
    "pokeDraft":     { ".read": true, "$section": { ".read": true, "$id": { ".read": true, ".write": true } } },
    "circleRipples": { ".read": true, "$section": { ".read": true, "$id": { ".read": true, ".write": true } } },

    "world": { ".read": true, "$section": { ".read": true, "$key": { ".read": true, ".write": true } } },

    "bookclub": {
      ".read": true,
      "admins": { "$uid": { ".validate": "newData.isBoolean()" } },
      "books": {
        ".read": true,
        "$id": {
          ".read": true,
          ".write": "auth != null && ((!data.exists() && newData.child('ownerPCID').val() === auth.uid) || (!newData.exists() && root.child('bookclub/admins/' + auth.uid).exists()) || (data.exists() && newData.exists() && data.child('ownerPCID').val() === auth.uid))",
          ".validate": "newData.hasChildren(['title','author','bookType','faith','description','suggestedBy','rating','note','formats','ownerPCID','createdAt'])",

          "bookType":    { ".validate": "newData.isString() && newData.val().matches(/^(Board Book|Children's Book|Teen Book|Adult Nonfiction|Adult Fiction)$/)" },
          "title":       { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 300" },
          "author":      { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
          "faith":       { ".validate": "newData.isString() && newData.val().matches(/^(Catholic|Christian|Not Christian, but has Christian elements)$/)" },
          "description": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 3000" },
          "suggestedBy": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 80" },
          "ownerPCID":   { ".validate": "newData.isString() && newData.val() === auth.uid" },
          "cover":       { ".validate": "newData.isString() && (newData.val() == '' || (newData.val().length <= 600 && newData.val().matches(/^https?:[/][/].*/)))" },
          "rating":      { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10" },
          "note":        { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000" },
          "warnings":    { ".validate": "newData.isString() && newData.val().length <= 1000" },
          "series":      { ".validate": "newData.isString() && newData.val().length <= 200" },
          "createdAt":   { ".validate": "newData.isNumber()" },
          "categories":  { "$i": { ".validate": "newData.isString() && newData.val().length <= 80" } },
          "formats":     { "$i": { ".validate": "newData.isString() && newData.val().matches(/^(Physical|Ebook|Audiobook)$/)" } },
          "links": {
            "$i": {
              ".validate": "newData.hasChildren(['url','desc'])",
              "url":  { ".validate": "newData.isString() && newData.val().length <= 600" },
              "desc": { ".validate": "newData.isString() && newData.val().length <= 120" },
              "$other": { ".validate": false }
            }
          },

          "status": {
            ".write": "auth != null && data.parent().exists()",
            ".validate": "newData.isString() && newData.val().matches(/^(suggested|reading|read)$/)"
          },

          "votes": {
            "$who": {
              ".write": "auth != null && $who === auth.uid && data.parent().parent().exists()",
              ".validate": "newData.isString() && newData.val().length <= 80 && $who === auth.uid"
            }
          },

          "likes": {
            "$who": {
              ".write": "auth != null && $who === auth.uid && data.parent().parent().exists()",
              ".validate": "newData.isBoolean() && $who === auth.uid"
            }
          },

          "ratings": {
            "$who": {
              ".write": "auth != null && $who === auth.uid && data.parent().parent().exists()",
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10 && $who === auth.uid"
            }
          },

          "comments": {
            "$cid": {
              ".write": "auth != null && !data.exists() && data.parent().parent().exists()",
              ".validate": "newData.hasChildren(['by','text','at','authorUID']) && newData.child('authorUID').val() === auth.uid",
              "by":        { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 80" },
              "text":      { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1000" },
              "at":        { ".validate": "newData.isNumber()" },
              "authorUID": { ".validate": "newData.isString()" },
              "$other": { ".validate": false }
            }
          },

          "$other": { ".validate": false }
        }
      }
    }
  }
}
